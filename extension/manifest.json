{
  "manifest_version": 3,
  "name": "GeForce NOW Xbox Controller Bridge",
  "version": "1.1.1",
  "description": "Bridges the PowerA Xbox wired controller into GeForce NOW (web) and hardwaretester.com via the local USB bridge daemon on ws://127.0.0.1:8765.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*",
    "ws://localhost/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://play.geforcenow.com/*",
        "*://*.geforcenow.com/*",
        "*://hardwaretester.com/*",
        "*://*.hardwaretester.com/*",
        "*://gamepad-tester.com/*",
        "*://*.gamepad-tester.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://play.geforcenow.com/*",
        "*://*.geforcenow.com/*",
        "*://hardwaretester.com/*",
        "*://*.hardwaretester.com/*",
        "*://gamepad-tester.com/*",
        "*://*.gamepad-tester.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
